<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.anand.moomoobot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/anandnarayanan/MoomooTradingBot/start_bot.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/anandnarayanan/MoomooTradingBot</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/anandnarayanan/MoomooTradingBot/logs/launchd_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/anandnarayanan/MoomooTradingBot/logs/launchd_stderr.log</string>
</dict>
</plist>
